# Copy to deploy/.env (gitignored) — or let deploy/scripts/generate-env create it with random secrets.
# Placeholders only: never commit real values.

# --- Database ------------------------------------------------------------------------------------
# Letters and digits only (it goes into a URL). generate-env makes a strong one.
POSTGRES_PASSWORD=replace-with-a-long-random-string
# The API's own login (cdls_app, not a superuser). Letters and digits only, different from POSTGRES_PASSWORD.
APP_DB_PASSWORD=replace-with-another-long-random-string

# --- Secrets (at least 32 characters each, different from each other) ----------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-long-random-string-for-refresh-tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- The school ----------------------------------------------------------------------------------
# The school pack of this install: the folder schools/<SCHOOL>/ (docs/new-school.md). It is read by the API when
# it starts AND baked into the web image when it is built, so change it only together with a rebuild:
#   docker compose -f deploy/compose.yaml --env-file deploy/.env up -d --build
# cdls-daher is Collège de la Salle, Daher; example is a fictional school for trying the platform out.
SCHOOL=cdls-daher

# --- Site address --------------------------------------------------------------------------------
# Public address of the site, https, no trailing slash. Base of the links in e-mails and the only
# origin allowed to call the API.
PUBLIC_WEB_URL=https://ecole.example.org
# Domain of the school login e-mails (prenom.nom@<domain>). The demo domain is refused in production.
SCHOOL_EMAIL_DOMAIN=example.org

# Port on THIS machine (127.0.0.1 only) where the site also answers, for a local check.
WEB_PORT=8080

# --- Proxy and cookies ---------------------------------------------------------------------------
# Number of proxies between the visitor and the API. The web container is one: keep 1.
TRUST_PROXY=1
# Secure flag of the refresh cookie. Leave EMPTY: it is on in production (HTTPS through the tunnel or Caddy).
# Put false only to try the stack over plain HTTP on an address other than localhost.
COOKIE_SECURE=

# --- E-mail (forgotten password) -----------------------------------------------------------------
# smtp is required in production. Ask your mail provider for these values.
MAIL_TRANSPORT=smtp
# Leave empty to send as "<school name> <no-reply@SCHOOL_EMAIL_DOMAIN>" (the name comes from the school profile).
MAIL_FROM=
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# true: TLS from the first byte (port 465). false: STARTTLS (port 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Rate limits (the defaults suit a school behind one address) --------------------------------
# THROTTLE_LIMIT counts per account for signed-in requests and per address otherwise, so one busy class
# behind the school's address does not block the others.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
LOGIN_THROTTLE_LIMIT=5
# Session refresh (every page load): per refresh token, and per address for all tokens together.
REFRESH_THROTTLE_LIMIT=10
REFRESH_IP_THROTTLE_LIMIT=1200
CONTACT_THROTTLE_LIMIT=5
TEMP_PASSWORD_TTL_DAYS=14
CONTACT_RETENTION_DAYS=365
PASSWORD_RESET_TTL_MINUTES=60

# --- Log ----------------------------------------------------------------------------------------
# error, warn, info (default) or debug. The API writes one JSON object per line (time, level, school,
# requestId, msg) to the container log (`docker compose logs api`). The X-Request-Id header of a response
# names the lines of its request; send your own X-Request-Id (8 to 64 characters) to follow one request.
LOG_LEVEL=info

# --- Profile `tunnel` (Cloudflare Tunnel, recommended for a home laptop) -------------------------
# Token of the tunnel, from Cloudflare Zero Trust > Networks > Tunnels. Treat it like a password.
TUNNEL_TOKEN=

# --- Profile `caddy` (server with a public IP, ports 80 and 443 open) ----------------------------
# Domain whose DNS A/AAAA record points at this server. PUBLIC_WEB_URL must be https://<DOMAIN>.
DOMAIN=

# --- Backups -------------------------------------------------------------------------------------
# Host folder receiving the nightly dumps (relative to deploy/), hour in UTC, days kept.
BACKUP_DIR=./backups
BACKUP_HOUR=02
BACKUP_RETENTION_DAYS=14
# Strongly recommended: encrypt every dump with an age PUBLIC key (age1...). Dumps then end in .dump.age.
# Make the key pair on another machine (`age-keygen -o cdls-backup.key`), put only the public key here and keep the
# private key off this laptop (password manager + a printed copy): without it the backups cannot be restored.
# See deploy/restore.md. Empty: dumps are written unencrypted (owner-only files).
BACKUP_AGE_RECIPIENT=
