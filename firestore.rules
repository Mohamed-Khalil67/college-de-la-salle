rules_version = '2';

// =================================================================================================
//  Exam Platform — zero-trust Firestore security model
//
//  Data layout (see libs/contracts/src/exam.contracts.ts):
//    exams/{examId}                     metadata ............ owner only
//    exams/{examId}/paper/current       questions, NO keys .. owner + candidate with a LIVE session
//    exams/{examId}/private/answerKey   correct answers ..... owner only (grader uses Admin SDK)
//    accessCodes/{code}                 lobby card .......... any signed-in user, exact get only
//    sessions/{examId_uid}              authoritative timer . read: candidate/owner, write: NOBODY
//    submissions/{examId_uid}           answers + score ..... create once by candidate before expiry;
//                                                          grades only via Cloud Functions
//
//  Principles:
//    1. Deny by default. Every allow below is an explicit, minimal grant.
//    2. Field-level secrecy is impossible in Firestore rules, so secrets live in separate documents.
//    3. Time is authoritative only when it comes from the server: `request.time` or values minted
//       by the Admin SDK. Client clocks are never trusted.
//    4. Server-owned fields (session timer, score) are unwritable by any client.
// =================================================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------------------------
    //  Identity helpers
    // ---------------------------------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // RBAC: the `role` custom claim ('super_admin' | 'examiner' | 'examinee') is set only by Cloud
    // Functions from examiner_directory. A missing claim means examinee.
    function role() {
      return request.auth.token.get('role', 'examinee');
    }

    // Zero-trust revocation: when a role is withdrawn, the server revokes the account's refresh
    // tokens and stamps user_metadata/{uid}.revokeTime. ID tokens minted before that (auth_time is
    // the sign-in time) are rejected for privileged access instead of living out their hour.
    function tokenFresh() {
      let metadata = /databases/$(database)/documents/user_metadata/$(uid());
      return !exists(metadata) || request.auth.token.auth_time > get(metadata).data.revokeTime;
    }

    // Exam authors: examiners and the super admin.
    function isExaminer() {
      return signedIn() && role() in ['super_admin', 'examiner'] && tokenFresh();
    }

    function isSuperAdmin() {
      return signedIn() && role() == 'super_admin' && tokenFresh();
    }

    function verifiedEmail() {
      return request.auth.token.get('email_verified', false) == true
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    // ---------------------------------------------------------------------------------------------
    //  Document helpers
    // ---------------------------------------------------------------------------------------------

    function examPath(examId) {
      return /databases/$(database)/documents/exams/$(examId);
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/sessions/$(sessionId);
    }

    // Owner-side access to exam data (answer keys, candidates' work) needs a LIVE author role:
    // ownership alone is not enough once the role has been revoked. The uid comparison runs first,
    // so candidates never pay for the role lookup.
    function isOwner(ownerId) {
      return ownerId == uid() && isExaminer();
    }

    // Ownership as currently stored (reads, deletes).
    function ownsExam(examId) {
      return signedIn()
        && exists(examPath(examId))
        && isOwner(get(examPath(examId)).data.ownerId);
    }

    // Ownership as it will be after this request/batch commits (creates & updates). This lets an
    // examiner write the exam + paper + answer key + access code in a single atomic batch.
    function ownsExamAfter(examId) {
      return isExaminer()
        && existsAfter(examPath(examId))
        && getAfter(examPath(examId)).data.ownerId == uid();
    }

    // Questions and answers freeze once the first candidate starts (the server sets lockedAt).
    function examUnlockedAfter(examId) {
      return getAfter(examPath(examId)).data.get('lockedAt', null) == null;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---------------------------------------------------------------------------------------------
    //  Shape validators
    // ---------------------------------------------------------------------------------------------

    function isAccessCode(code) {
      // Matches ACCESS_CODE_ALPHABET (no 0/O, 1/I/L) and LIMITS.accessCodeLength.
      return code is string && code.matches('^[A-HJKMNP-Z2-9]{6}$');
    }

    function isWindow(w) {
      return w is map
        && w.keys().hasOnly(['opensAt', 'closesAt'])
        && w.opensAt is timestamp
        && w.closesAt is timestamp
        && w.closesAt > w.opensAt;
    }

    function isIntegrityPolicy(p) {
      return p is map
        && p.keys().hasOnly(['maxVisibilityLosses'])
        && (p.maxVisibilityLosses == null
            || (p.maxVisibilityLosses is int && p.maxVisibilityLosses >= 0 && p.maxVisibilityLosses <= 50));
    }

    function isScoringPolicy(p) {
      return p is map
        && p.keys().hasAll(['passPercent', 'resultRelease'])
        && p.keys().hasOnly(['passPercent', 'resultRelease'])
        && (p.passPercent == null
            || ((p.passPercent is int || p.passPercent is float)
                && p.passPercent >= 0 && p.passPercent <= 100))
        && p.resultRelease in ['ON_GRADED', 'MANUAL'];
    }

    function isDeliveryPolicy(p, questionCount) {
      return p is map
        && p.keys().hasAll(['shuffleQuestions', 'shuffleOptions', 'questionsPerCandidate'])
        && p.keys().hasOnly(['shuffleQuestions', 'shuffleOptions', 'questionsPerCandidate'])
        && p.shuffleQuestions is bool
        && p.shuffleOptions is bool
        && (p.questionsPerCandidate == null
            || (p.questionsPerCandidate is int
                && p.questionsPerCandidate >= 1 && p.questionsPerCandidate <= questionCount));
    }

    function isAccessPolicy(p) {
      return p is map && p.keys().hasOnly(['mode']) && p.mode in ['CODE', 'ROSTER'];
    }

    function isSubjectId(s) {
      return s in ['arabic', 'physics', 'chemistry', 'mathematics'];
    }

    function isCatalogPolicy(p) {
      return p is map && p.keys().hasOnly(['subjectId', 'listed'])
        && (p.subjectId == null || isSubjectId(p.subjectId))
        && p.listed is bool;
    }

    function isExamMeta(d) {
      let fields = ['ownerId', 'title', 'description', 'durationSeconds', 'window', 'accessCode',
                    'integrity', 'scoring', 'delivery', 'access', 'status', 'lockedAt',
                    'resultsPublished', 'questionCount', 'maxScore', 'createdAt'];
      // `catalog` is optional so exams created before subjects existed stay valid.
      return d.keys().hasAll(fields) && d.keys().hasOnly(fields.concat(['catalog']))
        && (!('catalog' in d) || isCatalogPolicy(d.catalog))
        && d.ownerId == uid()
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.description is string && d.description.size() <= 2000
        && d.durationSeconds is int && d.durationSeconds >= 60 && d.durationSeconds <= 14400
        && isWindow(d.window)
        && isAccessCode(d.accessCode)
        && isIntegrityPolicy(d.integrity)
        && isScoringPolicy(d.scoring)
        && isDeliveryPolicy(d.delivery, d.questionCount)
        && isAccessPolicy(d.access)
        && d.status in ['DRAFT', 'PUBLISHED', 'CLOSED']
        && d.resultsPublished is bool
        && d.questionCount is int && d.questionCount >= 1 && d.questionCount <= 100
        && d.maxScore is int && d.maxScore >= 1
        && d.createdAt is timestamp;
    }

    // ---------------------------------------------------------------------------------------------
    //  Exams (examiner isolation: only the owner can read or write)
    // ---------------------------------------------------------------------------------------------

    match /exams/{examId} {
      // `list` is safe: Firestore rejects any query that is not constrained to ownerId == uid.
      allow read: if signedIn() && isOwner(resource.data.ownerId);

      allow create: if isExaminer()
        && isExamMeta(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status in ['DRAFT', 'PUBLISHED']
        && request.resource.data.lockedAt == null
        && request.resource.data.resultsPublished == false;

      // Before the first candidate starts: anything (except identity fields). Afterwards the exam
      // is frozen — only its lifecycle status and result publication may change.
      allow update: if isExaminer()
        && resource.data.ownerId == uid()
        && isExamMeta(request.resource.data)
        && unchanged('ownerId')
        && unchanged('accessCode')
        && unchanged('createdAt')
        && request.resource.data.lockedAt == resource.data.get('lockedAt', null)
        && (resource.data.get('lockedAt', null) == null
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'resultsPublished']));

      allow delete: if isExaminer() && resource.data.ownerId == uid() && resource.data.get('lockedAt', null) == null;

      // The full question bank: owner only. Candidates receive sessionPapers/* instead.
      match /paper/{docId} {
        allow read: if ownsExam(examId);

        allow create, update: if ownsExamAfter(examId)
          && examUnlockedAfter(examId)
          && docId == 'current'
          && request.resource.data.keys().hasOnly(['ownerId', 'questions'])
          && request.resource.data.ownerId == uid()
          && request.resource.data.questions is list
          && request.resource.data.questions.size() >= 1
          && request.resource.data.questions.size() <= 100;

        allow delete: if ownsExam(examId) && get(examPath(examId)).data.get('lockedAt', null) == null;
      }

      // Answer key + rubrics (frozen once locked) and the invitation roster (editable any time):
      // owner only. Candidates can NEVER read either.
      match /private/{docId} {
        allow read: if ownsExam(examId);

        allow create, update: if ownsExamAfter(examId)
          && request.resource.data.ownerId == uid()
          && (
            (docId == 'answerKey'
              && examUnlockedAfter(examId)
              && request.resource.data.keys().hasOnly(['ownerId', 'answers', 'rubrics'])
              && request.resource.data.answers is map
              && (!('rubrics' in request.resource.data) || request.resource.data.rubrics is map))
            || (docId == 'roster'
              && request.resource.data.keys().hasOnly(['ownerId', 'emails'])
              && request.resource.data.emails is list
              && request.resource.data.emails.size() <= 300)
          );

        allow delete: if ownsExam(examId) && docId == 'roster';
      }
    }

    // ---------------------------------------------------------------------------------------------
    //  Access codes (public lobby lookup by exact code; enumeration is blocked)
    // ---------------------------------------------------------------------------------------------

    function isAccessCodeShape(d) {
      return d.keys().hasOnly(['code', 'examId', 'ownerId', 'title', 'description', 'durationSeconds',
                               'questionCount', 'window', 'status', 'accessMode'])
        && isWindow(d.window)
        && d.status in ['DRAFT', 'PUBLISHED', 'CLOSED']
        && d.accessMode in ['CODE', 'ROSTER'];
    }

    match /accessCodes/{code} {
      allow get: if signedIn();
      allow list: if false;

      // A code can only be claimed once (create fails on an existing doc, and update requires the
      // existing owner), and only for an exam the caller owns whose accessCode matches.
      allow create: if isExaminer()
        && isAccessCode(code)
        && isAccessCodeShape(request.resource.data)
        && request.resource.data.code == code
        && request.resource.data.ownerId == uid()
        && ownsExamAfter(request.resource.data.examId)
        && getAfter(examPath(request.resource.data.examId)).data.accessCode == code;

      allow update: if isExaminer()
        && resource.data.ownerId == uid()
        && unchanged('code') && unchanged('examId') && unchanged('ownerId')
        && isAccessCodeShape(request.resource.data);

      allow delete: if isExaminer() && resource.data.ownerId == uid();
    }

    // ---------------------------------------------------------------------------------------------
    //  Invitations — how an invited candidate finds their exams. Readable only by the invited,
    //  verified email (and the owner); written only by the exam's owner.
    // ---------------------------------------------------------------------------------------------

    match /invitations/{inviteId} {
      allow read: if signedIn()
        && (isOwner(resource.data.ownerId)
            || (verifiedEmail() != '' && resource.data.email == verifiedEmail()));

      allow create, update: if isExaminer()
        && request.resource.data.keys().hasOnly(['examId', 'ownerId', 'email', 'code', 'title',
                                                 'durationSeconds', 'window', 'status'])
        && request.resource.data.ownerId == uid()
        && request.resource.data.email == request.resource.data.email.lower()
        && inviteId == request.resource.data.examId + '__' + request.resource.data.email
        && ownsExamAfter(request.resource.data.examId)
        && request.resource.data.status in ['DRAFT', 'PUBLISHED', 'CLOSED'];

      allow delete: if isExaminer() && resource.data.ownerId == uid();
    }

    // ---------------------------------------------------------------------------------------------
    //  Public portal content — readable by anyone, including signed-out visitors. School pages
    //  (history, news, gallery, curriculum) ship prerendered from the app bundle; these collections
    //  let the school manage the same content from the console later. Clients never write them.
    // ---------------------------------------------------------------------------------------------

    match /school_content/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    match /curriculum/{nodeId} {
      allow read: if true;
      allow write: if false;
    }

    // Practice cards: what a subject hub lists. Public read; written only by the exam's owner, and
    // only while the exam itself is published, open by code, and points at this exact code. The
    // card carries no questions — those are released per candidate when a session starts.
    match /practice_catalog/{examId} {
      allow read: if true;

      allow create, update: if ownsExamAfter(examId)
        && request.resource.data.keys().hasOnly(['examId', 'ownerId', 'subjectId', 'title', 'code',
                                                 'durationSeconds', 'questionCount', 'publishedAt'])
        && request.resource.data.examId == examId
        && request.resource.data.ownerId == uid()
        && isSubjectId(request.resource.data.subjectId)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.durationSeconds is int
        && request.resource.data.questionCount is int
        && request.resource.data.publishedAt == request.time
        && request.resource.data.code == getAfter(examPath(examId)).data.accessCode
        && getAfter(examPath(examId)).data.status == 'PUBLISHED'
        && getAfter(examPath(examId)).data.access.mode == 'CODE';

      // Deleting a card that doesn't exist is a no-op the authoring batch relies on.
      allow delete: if isExaminer() && (resource == null || resource.data.ownerId == uid());
    }

    // ---------------------------------------------------------------------------------------------
    //  RBAC administration — written ONLY by Cloud Functions (manageExaminerRole, refreshRole) and
    //  the bootstrap script. The super admin may read; nobody may write from a client.
    // ---------------------------------------------------------------------------------------------

    match /examiner_directory/{entry} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Immutable audit trail: no client create, update or delete, ever.
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /user_metadata/{userId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------------------------------
    //  Sessions (the authoritative timer)
    // ---------------------------------------------------------------------------------------------

    match /sessions/{sessionId} {
      allow read: if signedIn()
        && (resource.data.candidateId == uid() || isOwner(resource.data.examOwnerId));

      // startedAt / expiresAt / status are minted and advanced ONLY by Cloud Functions (Admin SDK
      // bypasses rules). No client can create, extend, reset, or delete a session.
      allow write: if false;
    }

    // This candidate's paper (bank draw + shuffles applied), built by the server at session start.
    // Readable by its candidate only while the session is live, and by the exam owner.
    match /sessionPapers/{sessionId} {
      allow get: if signedIn()
        && resource != null
        && (isOwner(resource.data.examOwnerId)
            || (resource.data.candidateId == uid()
                && get(sessionPath(sessionId)).data.status == 'ACTIVE'
                && request.time <= get(sessionPath(sessionId)).data.expiresAt));
      allow list: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------------------------------------
    //  Submissions
    // ---------------------------------------------------------------------------------------------

    function isIntegrityReport(r) {
      return r is map
        && r.keys().hasAll(['visibilityLossCount', 'hiddenMs'])
        && r.keys().hasOnly(['visibilityLossCount', 'hiddenMs'])
        && r.visibilityLossCount is int && r.visibilityLossCount >= 0
        && r.hiddenMs is int && r.hiddenMs >= 0;
    }

    function isValidSubmissionCreate(sessionId) {
      let session = get(sessionPath(sessionId)).data;
      let s = request.resource.data;
      let fields = ['sessionId', 'examId', 'examOwnerId', 'candidateId', 'candidateName', 'answers',
                    'integrity', 'completedBy', 'expiresAt', 'submittedAt'];
      return signedIn()
        && exists(sessionPath(sessionId))
        // Ownership: only the session's candidate, only for their own session.
        && session.candidateId == uid()
        && session.status == 'ACTIVE'
        // Strict deadline. `expiresAt` is pinned to the server-minted value, so the effective rule is
        // "reject when request.time > expiresAt" with no client-controlled input anywhere in it.
        && s.expiresAt == session.expiresAt
        && request.time <= s.expiresAt
        // Completion timestamp must be the server's clock, not the client's.
        && s.submittedAt == request.time
        // Exact shape — `score`, `maxScore`, `gradedAt` etc. are server-only and cannot be forged.
        && s.keys().hasAll(fields) && s.keys().hasOnly(fields)
        && s.sessionId == sessionId
        && s.examId == session.examId
        && s.examOwnerId == session.examOwnerId
        && s.candidateId == uid()
        && s.candidateName == session.candidateName
        && s.answers is map && s.answers.size() <= 100
        && isIntegrityReport(s.integrity)
        && s.completedBy in ['CANDIDATE', 'AUTO_TIMER', 'AUTO_INTEGRITY'];
    }

    // Session ids are "{examId}_{candidateUid}"; this proves the id belongs to the caller.
    function isOwnSessionId(sessionId) {
      return sessionId.matches('^[A-Za-z0-9-]+_' + uid() + '$');
    }

    // ---------------------------------------------------------------------------------------------
    //  Drafts (server-side autosave) — writable only by the session's candidate, only while live
    // ---------------------------------------------------------------------------------------------

    function isValidDraftWrite(sessionId) {
      let session = get(sessionPath(sessionId)).data;
      let d = request.resource.data;
      let fields = ['examId', 'candidateId', 'examOwnerId', 'answers', 'flagged', 'integrity',
                    'updatedAt'];
      return signedIn()
        && exists(sessionPath(sessionId))
        && session.candidateId == uid()
        && session.status == 'ACTIVE'
        && request.time <= session.expiresAt
        && d.keys().hasAll(fields) && d.keys().hasOnly(fields)
        && d.examId == session.examId
        && d.candidateId == uid()
        && d.examOwnerId == session.examOwnerId
        && d.answers is map && d.answers.size() <= 100
        && d.flagged is list && d.flagged.size() <= 100
        && isIntegrityReport(d.integrity)
        && d.updatedAt == request.time;
    }

    match /drafts/{sessionId} {
      allow get: if signedIn()
        && (
          (resource == null && isOwnSessionId(sessionId))
          || (resource != null && (resource.data.candidateId == uid() || isOwner(resource.data.examOwnerId)))
        );
      allow list: if signedIn() && isOwner(resource.data.examOwnerId);
      allow create, update: if isValidDraftWrite(sessionId);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------------------------------
    //  Results — the only place a candidate sees a score. Written exclusively by Cloud Functions,
    //  and only once the examiner's release policy allows it.
    // ---------------------------------------------------------------------------------------------

    match /results/{sessionId} {
      allow get: if signedIn()
        && (
          (resource == null && isOwnSessionId(sessionId))
          || (resource != null && (resource.data.candidateId == uid() || isOwner(resource.data.examOwnerId)))
        );
      allow list: if signedIn() && isOwner(resource.data.examOwnerId);
      allow write: if false;
    }

    match /submissions/{sessionId} {
      // Examiners: every submission to exams they own (get and list).
      // Candidates: only their OWN submission, only by exact id, and only until it is graded —
      // after that, scores reach them exclusively through `results/*` once released. Reading a
      // not-yet-existing own id is allowed so a client can tell "never arrived" from "arrived".
      allow list: if signedIn() && isOwner(resource.data.examOwnerId);
      allow get: if signedIn()
        && (
          (resource != null && isOwner(resource.data.examOwnerId))
          || (isOwnSessionId(sessionId)
              && (resource == null || resource.data.get('gradingStatus', null) == null))
        );

      allow create: if isValidSubmissionCreate(sessionId);

      // Final once written — for candidates AND examiners. Automatic grading, manual grades and AI
      // suggestions are all written by Cloud Functions (Admin SDK), which verify exam ownership.
      allow update, delete: if false;
    }
  }
}
