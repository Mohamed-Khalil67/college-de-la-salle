{
  "name": "exam-platform",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-exam-rules \"vitest run --config vitest.rules.config.mts\"",
    "test:e2e": "npm run functions:build && firebase emulators:exec --only auth,firestore,functions --project demo-exam-platform \"playwright test\"",
    "test:all": "ng test --watch=false && npm run test:rules && npm run test:e2e",
    "functions:build": "npm --prefix functions run build",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-exam-platform",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.ts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "firebase": "^12.19.0",
    "postcss": "^8.5.30",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.12.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
