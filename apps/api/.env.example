# Copy to .env (gitignored) and fill in. Never commit real values.

NODE_ENV=development
PORT=3000

# PostgreSQL 18 running natively. Create the `cdls` role and the `cdls_dev` database once with
# prisma/setup-database.sql, then put that role's password here (URL-encode special characters).
DATABASE_URL="postgresql://cdls:CHANGE_ME@localhost:5432/cdls_dev?schema=public"

# Comma-separated list of browser origins allowed to call the API (the Angular dev server).
CORS_ORIGIN=http://localhost:4200

# JWT secrets: at least 32 random characters each, different from each other. Generate with
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-long-random-string-for-refresh-tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Rate limit applied to every route: at most THROTTLE_LIMIT requests per THROTTLE_TTL_MS.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Sign-in attempts a minute per client. Keep 5 in production; the e2e suite needs about 30.
LOGIN_THROTTLE_LIMIT=5

# Contact-form messages a minute per client (public POST /api/contact).
CONTACT_THROTTLE_LIMIT=5

# Days a temporary password stays valid (accounts created, imported or reset by the administration).
TEMP_PASSWORD_TTL_DAYS=14

# Days a handled contact message is kept after it was marked handled (1 to 3650). A daily clean-up
# deletes older ones; waiting messages are never deleted automatically.
CONTACT_RETENTION_DAYS=365

# Reverse proxies in front of the API (0 when none). Rate limits then read the visitor's address from
# X-Forwarded-For; never set more than the real number of proxies.
TRUST_PROXY=0

# Domain of the school login e-mails generated for imported accounts (prenom.nom@<domain>).
# The demo domain below is refused in production: set the school's own.
SCHOOL_EMAIL_DOMAIN=demo.cdls.test
