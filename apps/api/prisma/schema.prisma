// CDLS data model: one school (Collège de la Salle, Daher). ERD: docs/brainstorm.md, section 4.
// Tables and columns are snake_case in PostgreSQL (@@map / @map); models and fields stay camelCase in TypeScript.
// The connection URL lives in prisma.config.ts (Prisma 7), read from DATABASE_URL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------------

enum Role {
  admin
  teacher
  student

  @@map("role")
}

/// RoomKind in packages/shared.
enum RoomKind {
  classroom
  lab
  gym
  hall

  @@map("room_kind")
}

/// PeriodKind in packages/shared.
enum PeriodKind {
  trimester
  semester

  @@map("period_kind")
}

/// CalendarDayType in packages/shared. `holiday` and `no_classes` cancel the weekly sessions of their audience.
enum CalendarDayType {
  holiday
  exam_week
  no_classes
  event_day

  @@map("calendar_day_type")
}

/// active: can sign in. disabled: blocked by an admin. archived: graduated or left, read-only, no sign-in.
enum UserStatus {
  active
  disabled
  archived

  @@map("user_status")
}

enum SectionChangeStatus {
  pending
  approved
  rejected

  @@map("section_change_status")
}

enum AttendanceStatus {
  present
  absent
  late
  excused

  @@map("attendance_status")
}

// ---------------------------------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------------------------------

/// An account. Created by an admin (no open sign-up). A teacher or student also has a profile row.
model User {
  id                         String     @id @default(uuid(7)) @db.Uuid
  /// Stored lower-cased.
  email                      String     @unique @db.VarChar(254)
  passwordHash               String     @map("password_hash")
  role                       Role
  firstName                  String     @map("first_name") @db.VarChar(80)
  lastName                   String     @map("last_name") @db.VarChar(80)
  status                     UserStatus @default(active)
  /// Set on every account the administration creates or resets: the user must choose a password first.
  mustChangePassword         Boolean    @default(true) @map("must_change_password")
  /// Access tokens issued before this instant are refused (password change or reset).
  passwordChangedAt          DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  /// While mustChangePassword: the temporary password stops working at this instant (null = no expiry).
  temporaryPasswordExpiresAt DateTime?  @map("temporary_password_expires_at") @db.Timestamptz(3)
  lastLoginAt                DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt                  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  student                 Student?
  teacher                 Teacher?
  posts                   Post[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  /// Contact messages this admin marked handled.
  contactMessagesHandled  ContactMessage[]
  sectionChangesRequested SectionChangeRequest[] @relation("SectionChangeRequestedBy")
  sectionChangesDecided   SectionChangeRequest[] @relation("SectionChangeDecidedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Student {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  /// School registration number (matricule).
  studentNumber String?   @unique @map("student_number") @db.VarChar(32)
  birthDate     DateTime? @map("birth_date") @db.Date
  /// Bac nationale or Bac français. Set at creation from the class; changed only by an approved SectionChangeRequest.
  sectionId     String?   @map("section_id") @db.Uuid
  /// The day the student graduated (the account is then archived).
  graduatedOn   DateTime? @map("graduated_on") @db.Date

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  section               Section?               @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  sectionChangeRequests SectionChangeRequest[]
  enrollments           Enrollment[]
  grades                Grade[]
  homeworkCompletions   HomeworkCompletion[]
  attendance            Attendance[]
  reportCards           ReportCard[]

  @@index([sectionId])
  @@map("students")
}

model Teacher {
  id            String  @id @default(uuid(7)) @db.Uuid
  userId        String  @unique @map("user_id") @db.Uuid
  /// Coordinateur: also edits the year's structure (subjects, rooms, periods, calendar days). Set by the admin.
  isCoordinator Boolean @default(false) @map("is_coordinator")

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments        TeachingAssignment[]
  timetableSlots     TimetableSlot[]
  slotExceptions     SlotException[]
  /// The teacher's private activity types.
  activityTypes      ActivityType[]
  events             Event[]
  gradesEntered      Grade[]
  attendanceRecorded Attendance[]

  @@map("teachers")
}

/// A refresh token (opaque, sent only in an httpOnly cookie). Only an HMAC of its secret is stored.
/// Every refresh rotates it; presenting a revoked token revokes its whole family (theft detection).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// All the tokens descended from one login.
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  userAgent String    @default("") @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------------------------------
// School structure
// ---------------------------------------------------------------------------------------------------

model SchoolYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// « 2026-2027 »
  label     String   @unique @db.VarChar(20)
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  /// Exactly one year is current (enforced by the service).
  isCurrent Boolean  @default(false) @map("is_current")

  periods      Period[]
  calendarDays CalendarDay[]
  classes      SchoolClass[]
  enrollments  Enrollment[]

  @@index([isCurrent])
  @@map("school_years")
}

/// A trimester or semester of a school year, for every section (sectionId null) or one section.
/// Periods of the same year, section and kind never overlap: EXCLUDE constraint `periods_no_overlap`
/// (btree_gist) in the migration SQL.
model Period {
  id           String     @id @default(uuid(7)) @db.Uuid
  schoolYearId String     @map("school_year_id") @db.Uuid
  kind         PeriodKind @default(trimester)
  sectionId    String?    @map("section_id") @db.Uuid
  /// 1 to 3 (trimesters), 1 or 2 (semesters); unique per year, section and kind.
  number       Int        @db.SmallInt
  label        String     @db.VarChar(40)
  startsOn     DateTime   @map("starts_on") @db.Date
  endsOn       DateTime   @map("ends_on") @db.Date
  /// Set when the period is closed: it is locked (no edit, no grade change) and report cards are generated.
  closedAt     DateTime?  @map("closed_at") @db.Timestamptz(3)

  schoolYear  SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  section     Section?     @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  reportCards ReportCard[]
  /// Gradable events whose grades count for this period.
  events      Event[]

  @@index([schoolYearId, kind])
  @@index([sectionId])
  @@index([startsOn, endsOn])
  @@map("periods")
}

/// Holidays, exam weeks, days without classes, special days. Audience: the listed classes when there are
/// any, else the section, else the whole school. `holiday` and `no_classes` cancel the weekly sessions.
model CalendarDay {
  id           String          @id @default(uuid(7)) @db.Uuid
  schoolYearId String          @map("school_year_id") @db.Uuid
  type         CalendarDayType
  label        String          @db.VarChar(120)
  startsOn     DateTime        @map("starts_on") @db.Date
  /// Included (CHECK ends_on >= starts_on in the migration SQL).
  endsOn       DateTime        @map("ends_on") @db.Date
  sectionId    String?         @map("section_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  schoolYear SchoolYear         @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  section    Section?           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classes    CalendarDayClass[]

  @@index([schoolYearId, startsOn])
  @@index([startsOn, endsOn])
  @@index([sectionId])
  @@map("calendar_days")
}

/// A class a calendar day is limited to.
model CalendarDayClass {
  calendarDayId String @map("calendar_day_id") @db.Uuid
  classId       String @map("class_id") @db.Uuid

  calendarDay CalendarDay @relation(fields: [calendarDayId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([calendarDayId, classId])
  @@index([classId])
  @@map("calendar_day_classes")
}

/// A track: `nationale` (Bac nationale) or `bac` (Bac français). Codes match SectionId in packages/shared.
model Section {
  id    String @id @default(uuid(7)) @db.Uuid
  code  String @unique @db.VarChar(20)
  label String @db.VarChar(80)

  classes            SchoolClass[]
  events             Event[]
  posts              Post[]
  periods            Period[]
  calendarDays       CalendarDay[]
  students           Student[]
  sectionChangesFrom SectionChangeRequest[] @relation("SectionChangeFrom")
  sectionChangesTo   SectionChangeRequest[] @relation("SectionChangeTo")

  @@map("sections")
}

/// A class of one section for one school year, e.g. Bac français — Première, 2026-2027.
model SchoolClass {
  id           String @id @default(uuid(7)) @db.Uuid
  schoolYearId String @map("school_year_id") @db.Uuid
  sectionId    String @map("section_id") @db.Uuid
  /// Matches CLASSES[section][].value in packages/shared (`premiere`, `secondaire-1`…).
  code         String @db.VarChar(40)
  label        String @db.VarChar(80)

  schoolYear         SchoolYear             @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  section            Section                @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  enrollments        Enrollment[]
  subjects           ClassSubject[]
  events             Event[]
  posts              Post[]
  reportCards        ReportCard[]
  calendarDays       CalendarDayClass[]
  /// Section changes that moved a student into this class.
  sectionChangesInto SectionChangeRequest[]

  @@unique([schoolYearId, sectionId, code])
  @@index([sectionId])
  @@map("school_classes")
}

/// A student in a class. At most one open enrolment (leftOn null) per student and school year; a closed one
/// (moved by a section change, graduated, left) stays as history.
model Enrollment {
  id           String    @id @default(uuid(7)) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  classId      String    @map("class_id") @db.Uuid
  /// Same as the class's school year; denormalised so the unique constraint below can hold.
  schoolYearId String    @map("school_year_id") @db.Uuid
  enrolledOn   DateTime  @default(now()) @map("enrolled_on") @db.Date
  leftOn       DateTime? @map("left_on") @db.Date

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)
  schoolYear  SchoolYear  @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)

  @@unique([studentId, schoolYearId], where: raw("left_on IS NULL"), map: "enrollments_open_student_year_key")
  @@index([studentId, schoolYearId])
  @@index([classId])
  @@index([schoolYearId])
  @@map("enrollments")
}

/// A catalogue subject, created by the admin or a coordinator (seeded from MATIERES in packages/shared).
/// `id` is a stable slug made from the name (`mathematiques`), stored on events and posts.
model Subject {
  id         String    @id @db.VarChar(40)
  name       String    @db.VarChar(120)
  /// Display group (« Sciences »…).
  group      String    @db.VarChar(60)
  /// Section codes (SectionId in packages/shared) the subject can be taught in.
  sections   String[]  @default([]) @db.VarChar(20)
  /// Archived subjects stay on past grades but can't be added to a class.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  classSubjects ClassSubject[]
  events        Event[]
  posts         Post[]

  @@map("subjects")
}

/// A subject taught in a class, with its weight in the class's general average (report cards, averages).
model ClassSubject {
  id           String   @id @default(uuid(7)) @db.Uuid
  classId      String   @map("class_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.VarChar(40)
  coefficient  Decimal  @default(1) @db.Decimal(4, 2)
  /// Hours per week, null when not set.
  hoursPerWeek Decimal? @map("hours_per_week") @db.Decimal(4, 2)

  schoolClass SchoolClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assignments TeachingAssignment[]
  slots       TimetableSlot[]

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@map("class_subjects")
}

/// A teacher of a class subject. Drives the « a teacher only edits the classes they teach » guards.
model TeachingAssignment {
  id             String @id @default(uuid(7)) @db.Uuid
  teacherId      String @map("teacher_id") @db.Uuid
  classSubjectId String @map("class_subject_id") @db.Uuid

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classSubjectId])
  @@index([classSubjectId])
  @@map("teaching_assignments")
}

/// A room of the school. Events may book one (`Event.roomId`); clashes are checked from phase 2 on (an
/// occupancy table with exclusion constraints).
model Room {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.VarChar(60)
  /// Seats, null when unknown.
  capacity  Int?     @db.SmallInt
  kind      RoomKind @default(classroom)
  /// Inactive rooms can't be chosen for new events.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  events         Event[]
  slots          TimetableSlot[]
  slotExceptions SlotException[]

  @@map("rooms")
}

/// A type of calendar activity (cours, TD, examen… or a teacher's own); replaced the `event_kind` enum.
/// Code relies on the flags, never on `code`. A private type has an owner; school-wide types have none.
model ActivityType {
  id             String    @id @default(uuid(7)) @db.Uuid
  /// Stable slug; for system types, the old enum value.
  code           String    @unique @db.VarChar(40)
  label          String    @db.VarChar(60)
  /// A token of ACTIVITY_COLOURS in packages/shared (never a free hex value).
  colour         String    @db.VarChar(20)
  /// One of ACTIVITY_ICONS in packages/shared.
  icon           String    @db.VarChar(20)
  gradable       Boolean   @default(false)
  repeatable     Boolean   @default(false)
  homework       Boolean   @default(false)
  isSystem       Boolean   @default(false) @map("is_system")
  ownerTeacherId String?   @map("owner_teacher_id") @db.Uuid
  /// System types first, in the order of SYSTEM_ACTIVITY_TYPES.
  sortOrder      Int       @default(100) @map("sort_order") @db.SmallInt
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  owner  Teacher?        @relation(fields: [ownerTeacherId], references: [id], onDelete: Cascade)
  events Event[]
  slots  TimetableSlot[]

  @@index([ownerTeacherId])
  @@map("activity_types")
}

// ---------------------------------------------------------------------------------------------------
// Timetable (phase 2): the weekly rule and its exceptions are the source of truth; `occupancy` is an index
// ---------------------------------------------------------------------------------------------------

/// WeekParity in packages/shared: a fortnightly slot runs in week A or week B only.
enum WeekParity {
  A
  B

  @@map("week_parity")
}

/// SlotExceptionKind in packages/shared.
enum SlotExceptionKind {
  cancelled
  moved
  substitute
  room_change

  @@map("slot_exception_kind")
}

/// OccupancySource in packages/shared.
enum OccupancySource {
  slot
  exception
  event

  @@map("occupancy_source")
}

/// A weekly lesson of a class: a subject, a teacher, a room, a day and a time, valid from one day to another.
/// Sessions are computed from it (`expandTimetable` in packages/shared); holidays are never stored.
model TimetableSlot {
  id             String      @id @default(uuid(7)) @db.Uuid
  classSubjectId String      @map("class_subject_id") @db.Uuid
  /// Placeholder for phase 3 (groups): no foreign key yet, always null.
  groupId        String?     @map("group_id") @db.Uuid
  /// Division of the groups that run in parallel (« TP », « LV2 »). Null: the whole class. Two slots of one
  /// class may overlap only when both carry the same division.
  division       String?     @db.VarChar(40)
  teacherId      String      @map("teacher_id") @db.Uuid
  roomId         String?     @map("room_id") @db.Uuid
  activityTypeId String      @map("activity_type_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday.
  weekday        Int         @db.SmallInt
  startTime      String      @map("start_time") @db.VarChar(5)
  endTime        String      @map("end_time") @db.VarChar(5)
  /// Included (CHECKs on the weekday, the times and the dates in the migration SQL).
  validFrom      DateTime    @map("valid_from") @db.Date
  validTo        DateTime    @map("valid_to") @db.Date
  weekParity     WeekParity? @map("week_parity")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  classSubject ClassSubject    @relation(fields: [classSubjectId], references: [id], onDelete: Restrict)
  teacher      Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  room         Room?           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  activityType ActivityType    @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  exceptions   SlotException[]
  occupancy    Occupancy[]

  @@index([classSubjectId, validFrom])
  @@index([teacherId, validFrom])
  @@index([roomId, validFrom])
  @@index([activityTypeId])
  @@index([validFrom, validTo])
  @@map("timetable_slots")
}

/// One change to one session of a slot (`date` is the session's ORIGINAL day; one exception per session).
model SlotException {
  id           String            @id @default(uuid(7)) @db.Uuid
  slotId       String            @map("slot_id") @db.Uuid
  date         DateTime          @db.Date
  kind         SlotExceptionKind
  newDate      DateTime?         @map("new_date") @db.Date
  newStart     String?           @map("new_start") @db.VarChar(5)
  newEnd       String?           @map("new_end") @db.VarChar(5)
  newRoomId    String?           @map("new_room_id") @db.Uuid
  newTeacherId String?           @map("new_teacher_id") @db.Uuid
  reason       String            @default("") @db.VarChar(500)
  createdById  String?           @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  slot       TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  newRoom    Room?         @relation(fields: [newRoomId], references: [id], onDelete: Restrict)
  newTeacher Teacher?      @relation(fields: [newTeacherId], references: [id], onDelete: Restrict)
  occupancy  Occupancy[]

  @@unique([slotId, date])
  @@index([date])
  @@index([newRoomId])
  @@index([newTeacherId])
  @@map("slot_exceptions")
}

/// The occupancy INDEX: who holds which room, teacher and class during which time. Rebuilt in the same
/// transaction as every change to a slot, an exception or a one-off event (raw SQL; this model only lets
/// Prisma own the table). Exclusion constraints in the migration SQL (btree_gist) make a double booking
/// impossible even when two people save at once:
///   occupancy_room_no_overlap, occupancy_teacher_no_overlap, occupancy_class_whole_no_overlap,
///   occupancy_class_division_no_overlap.
model Occupancy {
  id          String                 @id @default(uuid(7)) @db.Uuid
  source      OccupancySource
  slotId      String?                @map("slot_id") @db.Uuid
  exceptionId String?                @map("exception_id") @db.Uuid
  eventId     String?                @map("event_id") @db.Uuid
  /// The session's original day (slots, exceptions) or the event's day.
  day         DateTime               @db.Date
  roomId      String?                @map("room_id") @db.Uuid
  teacherId   String?                @map("teacher_id") @db.Uuid
  classId     String?                @map("class_id") @db.Uuid
  /// Non-null: groups of the same division may share the class.
  divisionKey String?                @map("division_key") @db.VarChar(40)
  /// Wall-clock time of the school, no time zone.
  during      Unsupported("tsrange")

  slot      TimetableSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  exception SlotException? @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  event     Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([exceptionId])
  @@index([eventId])
  @@index([day])
  @@index([roomId])
  @@index([teacherId])
  @@index([classId])
  @@map("occupancy")
}

// ---------------------------------------------------------------------------------------------------
// Calendar, homework, grades, attendance
// ---------------------------------------------------------------------------------------------------

/// A calendar event (CalendarEvent in packages/shared): course slot, exam, homework deadline, meeting…
/// Audience: classId set → one class; only sectionId set → a whole section; both null → the whole school.
model Event {
  id             String    @id @default(uuid(7)) @db.Uuid
  activityTypeId String    @map("activity_type_id") @db.Uuid
  title          String    @db.VarChar(120)
  subjectId      String?   @map("subject_id") @db.VarChar(40)
  classId        String?   @map("class_id") @db.Uuid
  sectionId      String?   @map("section_id") @db.Uuid
  /// The day, or the first day of a weekly series.
  date           DateTime  @db.Date
  /// HH:MM, null for an all-day event.
  startTime      String?   @map("start_time") @db.VarChar(5)
  endTime        String?   @map("end_time") @db.VarChar(5)
  /// Repeats every week until this day (included); null for a single event. Only repeatable types.
  repeatUntil    DateTime? @map("repeat_until") @db.Date
  /// A room of the school; `place` stays free text (for places outside the school).
  roomId         String?   @map("room_id") @db.Uuid
  place          String    @default("") @db.VarChar(120)
  /// Gradable events: the period their grades count for (report cards read this, never the dates).
  periodId       String?   @map("period_id") @db.Uuid
  description    String    @default("") @db.VarChar(2000)
  /// [{ label, url }], https links only (validated by the API).
  attachments    Json      @default("[]")
  /// Weight of the grades given for it (gradable types).
  coefficient    Decimal   @default(1) @db.Decimal(4, 2)
  authorId       String    @map("author_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  activityType        ActivityType         @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  room                Room?                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  period              Period?              @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subject             Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  schoolClass         SchoolClass?         @relation(fields: [classId], references: [id], onDelete: Cascade)
  section             Section?             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author              Teacher              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  grades              Grade[]
  homeworkCompletions HomeworkCompletion[]
  attendance          Attendance[]
  occupancy           Occupancy[]

  @@index([classId, date])
  @@index([sectionId, date])
  @@index([date])
  @@index([authorId])
  @@index([subjectId])
  @@index([activityTypeId, date])
  @@index([roomId, date])
  @@index([periodId])
  @@map("events")
}

/// One mark per student per gradable event; entering it again corrects it.
model Grade {
  id         String   @id @default(uuid(7)) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  score      Decimal  @db.Decimal(5, 2)
  outOf      Decimal  @default(20) @map("out_of") @db.Decimal(5, 2)
  comment    String   @default("") @db.VarChar(1000)
  /// Students only see published grades.
  published  Boolean  @default(false)
  gradedById String   @map("graded_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy Teacher @relation(fields: [gradedById], references: [id], onDelete: Restrict)

  @@unique([eventId, studentId])
  @@index([studentId, published])
  @@index([gradedById])
  @@map("grades")
}

/// A student ticked a « devoir » as done.
model HomeworkCompletion {
  eventId   String   @map("event_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  doneAt    DateTime @default(now()) @map("done_at") @db.Timestamptz(3)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([eventId, studentId])
  @@index([studentId])
  @@map("homework_completions")
}

/// Roll call for one occurrence of a course event (`date`, since weekly events repeat).
model Attendance {
  id           String           @id @default(uuid(7)) @db.Uuid
  eventId      String           @map("event_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  date         DateTime         @db.Date
  status       AttendanceStatus
  minutesLate  Int?             @map("minutes_late") @db.SmallInt
  note         String           @default("") @db.VarChar(500)
  recordedById String           @map("recorded_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy Teacher @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([eventId, studentId, date])
  @@index([studentId, date])
  @@index([eventId, date])
  @@index([recordedById])
  @@map("attendance")
}

/// A student's report card for a period (bulletin), generated after the period is closed.
model ReportCard {
  id           String    @id @default(uuid(7)) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  periodId     String    @map("period_id") @db.Uuid
  /// The class the student was in for that period.
  classId      String    @map("class_id") @db.Uuid
  /// General average on 20, null when there were no grades.
  average      Decimal?  @db.Decimal(4, 2)
  rank         Int?      @db.SmallInt
  appreciation String    @default("") @db.VarChar(2000)
  /// Snapshot of the per-subject averages and coefficients at generation time.
  subjects     Json      @default("[]")
  generatedAt  DateTime  @default(now()) @map("generated_at") @db.Timestamptz(3)
  /// Students only see published report cards.
  publishedAt  DateTime? @map("published_at") @db.Timestamptz(3)

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period      Period      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, periodId])
  @@index([periodId, classId])
  @@index([classId])
  @@map("report_cards")
}

/// A request to move a student to the other section. Only one pending request per student (partial unique
/// index). Approval moves the student in one transaction (StudentSectionService).
model SectionChangeRequest {
  id            String              @id @default(uuid(7)) @db.Uuid
  studentId     String              @map("student_id") @db.Uuid
  fromSectionId String              @map("from_section_id") @db.Uuid
  toSectionId   String              @map("to_section_id") @db.Uuid
  reason        String              @db.VarChar(1000)
  status        SectionChangeStatus @default(pending)
  /// The student, or the member of staff who entered it for them.
  requestedById String              @map("requested_by_id") @db.Uuid
  decidedById   String?             @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote  String              @default("") @map("decision_note") @db.VarChar(1000)
  /// Approved: the class of the new section the student was enrolled in.
  newClassId    String?             @map("new_class_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromSection Section      @relation("SectionChangeFrom", fields: [fromSectionId], references: [id], onDelete: Restrict)
  toSection   Section      @relation("SectionChangeTo", fields: [toSectionId], references: [id], onDelete: Restrict)
  requestedBy User         @relation("SectionChangeRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?        @relation("SectionChangeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  newClass    SchoolClass? @relation(fields: [newClassId], references: [id], onDelete: SetNull)

  @@unique([studentId], where: raw("status = 'pending'"), map: "section_change_requests_one_pending_key")
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@index([fromSectionId])
  @@index([toSectionId])
  @@index([requestedById])
  @@index([decidedById])
  @@index([newClassId])
  @@map("section_change_requests")
}

// ---------------------------------------------------------------------------------------------------
// Announcements and audit
// ---------------------------------------------------------------------------------------------------

/// An announcement. Same audience rule as Event: class, section, or whole school when both are null.
model Post {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String   @db.VarChar(120)
  body      String   @db.VarChar(4000)
  subjectId String?  @map("subject_id") @db.VarChar(40)
  classId   String?  @map("class_id") @db.Uuid
  sectionId String?  @map("section_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  schoolClass SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  section     Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([classId, createdAt])
  @@index([sectionId, createdAt])
  @@index([authorId])
  @@map("posts")
}

/// Who changed what (grade changes from day one). `before` / `after` hold the changed fields.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  /// Null for system actions.
  actorId   String?  @map("actor_id") @db.Uuid
  /// e.g. `grade.update`, `report_card.publish`.
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(60)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------------
// Public site
// ---------------------------------------------------------------------------------------------------

/// A message sent from the public contact form (POST /api/contact), read by the admins.
model ContactMessage {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.VarChar(120)
  /// Stored as typed (trimmed); the secretariat replies to it.
  email       String    @db.VarChar(254)
  phone       String    @default("") @db.VarChar(40)
  subject     String    @db.VarChar(120)
  /// Track and class the message is about, empty when not given.
  track       String    @default("") @db.VarChar(120)
  message     String    @db.VarChar(1000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when an admin marks it handled.
  handledAt   DateTime? @map("handled_at") @db.Timestamptz(3)
  handledById String?   @map("handled_by_id") @db.Uuid

  handledBy User? @relation(fields: [handledById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([handledAt, createdAt])
  @@index([handledById])
  @@map("contact_messages")
}
