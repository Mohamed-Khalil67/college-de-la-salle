{
  "hosting": {
    "public": "dist/exam-platform/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/images/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.csr.html" }]
  }
}